rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper Functions (輔助函式)
    // =============================================

    // 1. 檢查使用者是否已登入
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. 取得使用者的角色資料
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // 3. 檢查是否為管理員
    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'admin';
    }

    // 4. 檢查是否為主管或管理員
    function isManagerOrAdmin() {
      return isSignedIn() && (
        getUserRole(request.auth.uid) == 'manager' || getUserRole(request.auth.uid) == 'admin'
      );
    }

    // 4.5 外部紀錄員（幫忙打會議紀錄的外單位人員）：
    //     只能用會議紀錄／請假／業績報表，動態查詢的資料一律不給讀
    function isRecorder() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'recorder';
    }

    // 5. 檢查是否有權限管理內容 (助理、主管、管理員)
    function canManageContent() {
      return isSignedIn() && (
        getUserRole(request.auth.uid) == 'assistant' ||
        getUserRole(request.auth.uid) == 'manager' ||
        getUserRole(request.auth.uid) == 'admin'
      );
    }

    // =============================================
    // Collection: users
    // =============================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if canManageContent();
      allow update: if isSignedIn() && (request.auth.uid == userId || canManageContent());
      allow delete: if isSignedIn() && (
        getUserRole(request.auth.uid) == 'admin' || getUserRole(request.auth.uid) == 'assistant'
      );
    }

    // =============================================
    // Collection: records (會議紀錄)
    // =============================================
    match /records/{recordId} {
      allow read: if isSignedIn();
      allow create: if canManageContent() || isRecorder();   // 紀錄員可以發會議紀錄

      allow update: if isSignedIn() &&
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) ||
                      (request.auth.uid == resource.data.authorId || isManagerOrAdmin()));

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.uid ||
        request.auth.uid == resource.data.author ||
        isManagerOrAdmin()
      );
    }

    // =============================================
    // Collection: leave_requests (請假申請)
    // =============================================
    match /leave_requests/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isManagerOrAdmin();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorId || isManagerOrAdmin()
      );
    }

    // =============================================
    // Collection: schedules (值班表/事件)
    // =============================================
    match /schedules/{scheduleId} {
      allow read, write: if isManagerOrAdmin();
    }

    // =============================================
    // Collection: sales_reports (業績報表)
    // =============================================
    match /sales_reports/{year} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // =============================================
    // Collection: settings (組別設定)
    // =============================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if canManageContent();
    }

    // =============================================
    // Collection: private_reports (銷售分析 — 漢書彙總)
    // =============================================
    match /private_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =============================================
    // Collection: dt_tours (D1 動態查詢 — 漢書每小時同步)
    // 寫入只有 sync.mjs 的 Admin SDK 能做，前端一律不可寫
    // =============================================
    match /dt_tours/{docId} {
      allow read: if isSignedIn() && !isRecorder();
      allow write: if false;
    }

    // dt_raw：漢書原文（原始排版顯示模式用），權限同 dt_tours
    match /dt_raw/{docId} {
      allow read: if isSignedIn() && !isRecorder();
      allow write: if false;
    }

    // dt_files：公司雲行程檔案樹（選取行程檔案用），權限同 dt_tours
    match /dt_files/{docId} {
      allow read: if isSignedIn() && !isRecorder();
      allow write: if false;
    }

    // dt_flights：行程 PDF 抽出的航班表（航班核對用，flights.mjs 每小時寫），權限同 dt_files
    //   ⚠ 2026-10-16 補：航班核對 10/15 上線時漏了這條，前端讀不到 → 標籤一直不出現
    match /dt_flights/{docId} {
      allow read: if isSignedIn() && !isRecorder();
      allow write: if false;
    }

    // itin_confirm：行程版本確認表（confirm.mjs 每小時寫；網站、產品部確認頁、動態都要讀）
    //   產品部沒有這個系統的帳號，確認頁 confirm.html 不登入 → 開放讀；寫只有 Admin SDK
    match /itin_confirm/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // itin_pick_answers：產品部在 confirm.html 點的答案（一套路一份），不登入可寫；sync 下一輪合併進 itin_confirm
    //   只收固定幾個欄位、字數有限，避免被當成任意儲存空間
    match /itin_pick_answers/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['v', 'by', 'at', 'note', 'key'])
                   && request.resource.data.v is string && request.resource.data.v.size() <= 64
                   && (!('note' in request.resource.data) || request.resource.data.note.size() <= 300)
                   && (!('by' in request.resource.data) || request.resource.data.by.size() <= 40);
    }

    // dt_agent：動態查詢的業務個人設定（轉換連結用的名片資料），只能讀寫自己的
    match /dt_agent/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && !isRecorder();
    }

    // dt_follow：追蹤團清單（餘位/價格變動 LINE 通知用），只能讀寫自己的
    // 警報比對由 follow-alert.mjs 用 Admin SDK 讀全部（不受規則限制）
    match /dt_follow/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && !isRecorder();
    }

    // dt_manual：「我的團」的手動標記（手動歸檔備忘等），組內都可讀寫、紀錄員不行
    // 只是備忘標記，不影響合約系統的真實歸檔狀態
    match /dt_manual/{docId} {
      allow read, write: if isSignedIn() && !isRecorder();
    }
  }
}
